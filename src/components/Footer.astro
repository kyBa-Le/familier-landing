---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
      <span class="font-bold text-slate-100 text-base">
        {siteConfig.name}
      </span>
      <span class="hidden sm:inline text-slate-600">•</span>
      <span class="text-xs text-slate-400">
        © {currentYear} {siteConfig.name}. Built as an open-source project.
      </span>
    </div>

    <nav class="flex items-center gap-6 text-xs font-medium" aria-label="Footer navigation">
      <a 
        href={siteConfig.github.mobile}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors focus:outline-none focus:ring-1 focus:ring-emerald-500 rounded px-1"
      >
        Mobile Repository
      </a>
      <a 
        href={siteConfig.github.backend}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors focus:outline-none focus:ring-1 focus:ring-emerald-500 rounded px-1"
      >
        Backend Repository
      </a>
    </nav>
  </div>
</footer>
