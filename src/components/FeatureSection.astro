---

<section id="features" class="py-16 md:py-24 bg-slate-50 border-t border-slate-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <h2 class="text-3xl font-bold text-slate-900 tracking-tight mb-3">
        Key features
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Designed to bring clarity, organization, and effortless assistance to family daily life.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {siteConfig.features.map((feature, idx) => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-2xs hover:shadow-md transition-shadow duration-200 flex flex-col sm:flex-row gap-5 items-start">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={icons[idx]}>
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-slate-900 mb-2">
              {feature.title}
            </h3>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
