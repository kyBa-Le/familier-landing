---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
import { siteConfig } from '../config/site';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 border-b border-slate-200/80 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo & Name -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg p-1">
      <div class="w-9 h-9 rounded-xl overflow-hidden shadow-xs border border-slate-200/60 bg-white flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
        <Image 
          src={logoImage} 
          alt={`${siteConfig.name} Logo`} 
          width={36} 
          height={36} 
          class="w-full h-full object-cover" 
          loading="eager"
        />
      </div>
      <span class="font-bold text-lg text-slate-900 tracking-tight group-hover:text-emerald-600 transition-colors">
        {siteConfig.name}
      </span>
    </a>

    <!-- Right Side Actions -->
    <nav class="flex items-center gap-4">
      <a 
        href="#explore-project" 
        class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors hidden sm:block focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-md px-2 py-1"
      >
        Source Code
      </a>
      <a 
        href={siteConfig.github.mobile} 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="View Familier Mobile Repository on GitHub"
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 hover:text-slate-900 border border-slate-200 px-3.5 py-1.5 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>
