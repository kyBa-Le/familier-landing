---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
import InstallButton from './InstallButton.astro';
import { siteConfig } from '../config/site';
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <!-- Subtle Background Accent -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-50/60 via-slate-50 to-slate-50"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- App Icon / Logo -->
    <div class="inline-block mb-6 relative">
      <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl overflow-hidden shadow-xl border-2 border-white/80 bg-white mx-auto transform hover:scale-105 transition-transform duration-300">
        <Image
          src={logoImage}
          alt={`${siteConfig.name} App Icon`}
          width={112}
          height={112}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>

    <!-- App Name (H1 for single H1 per page rule) -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-3">
      {siteConfig.name}
    </h1>

    <!-- Tagline -->
    <p class="text-xl sm:text-2xl font-medium text-emerald-700 max-w-2xl mx-auto mb-4">
      {siteConfig.tagline}
    </p>

    <!-- Short Description -->
    <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto mb-8 leading-relaxed">
      {siteConfig.description}
    </p>

    <!-- Platform Badges -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-slate-600 mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200/80 shadow-2xs">
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.552 0 1.0003.4482 1.0003.9993s-.4483.9997-1.0003.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.552 0 1.0003.4482 1.0003.9993s-.4483.9997-1.0003.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.4158.4158 0 00-.568.1523l-2.0223 3.503C15.594 8.358 13.856 8 12 8s-3.594.358-5.1365.95l-2.0223-3.503a.4158.4158 0 00-.568-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6825 11.233.3448 14.807 0 19h24c-.3448-4.193-2.6825-7.767-6.1185-9.6786z"/>
        </svg>
        Android APK
      </span>
      <span class="text-slate-300">•</span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200/80 shadow-2xs">
        <svg class="w-4 h-4 text-slate-700" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        Open Source
      </span>
      <span class="text-slate-300">•</span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200/80 shadow-2xs">
        <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        AI-Powered
      </span>
    </div>

    <!-- CTA Button Area -->
    <div class="flex flex-col items-center gap-3">
      <InstallButton size="lg" />
      <span class="text-xs text-slate-500 font-medium">
        Available as Android APK installation
      </span>
    </div>
  </div>
</section>
