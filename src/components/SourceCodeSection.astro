---
import { siteConfig } from '../config/site';

const mobileTech = ['React Native', 'Expo', 'TypeScript'];
const backendTech = ['Java', 'Spring Boot', 'Microservices', 'WebFlux', 'AI Integration'];
---

<section id="explore-project" class="py-16 md:py-24 bg-white border-t border-slate-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <h2 class="text-3xl font-bold text-slate-900 tracking-tight mb-3">
        Explore the project
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Familier is fully open-source. Inspect our mobile application and backend microservices architecture on GitHub.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      <!-- Mobile Repository Card -->
      <div class="bg-slate-50/80 rounded-2xl p-6 sm:p-8 border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 bg-emerald-100/80 border border-emerald-200/60 px-3 py-1 rounded-full">
              Mobile Application
            </span>
            <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-2">
            Mobile Repository
          </h3>

          <p class="text-slate-600 text-sm sm:text-base mb-6 leading-relaxed">
            Cross-platform React Native frontend powering Familier’s real-time family chat and contextual assistance.
          </p>

          <!-- Tech Tags -->
          <div class="flex flex-wrap gap-2 mb-8">
            {mobileTech.map(tech => (
              <span class="text-xs font-medium text-slate-700 bg-white border border-slate-200 px-2.5 py-1 rounded-md">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <a 
          href={siteConfig.github.mobile}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View mobile source code on GitHub"
          class="inline-flex items-center justify-between w-full font-semibold text-slate-900 bg-white hover:bg-slate-100 border border-slate-300 px-4 py-3 rounded-xl transition-all duration-200 group focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          <span>View mobile source</span>
          <svg class="w-4 h-4 text-slate-500 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Backend Repository Card -->
      <div class="bg-slate-50/80 rounded-2xl p-6 sm:p-8 border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-800 bg-indigo-100/80 border border-indigo-200/60 px-3 py-1 rounded-full">
              Backend Architecture
            </span>
            <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-2">
            Backend Repository
          </h3>

          <p class="text-slate-600 text-sm sm:text-base mb-6 leading-relaxed">
            High-performance reactive microservices providing AI streaming, family management, and data synchronization.
          </p>

          <!-- Tech Tags -->
          <div class="flex flex-wrap gap-2 mb-8">
            {backendTech.map(tech => (
              <span class="text-xs font-medium text-slate-700 bg-white border border-slate-200 px-2.5 py-1 rounded-md">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <a 
          href={siteConfig.github.backend}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View backend source code on GitHub"
          class="inline-flex items-center justify-between w-full font-semibold text-slate-900 bg-white hover:bg-slate-100 border border-slate-300 px-4 py-3 rounded-xl transition-all duration-200 group focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          <span>View backend source</span>
          <svg class="w-4 h-4 text-slate-500 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
